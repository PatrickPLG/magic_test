<script>
  // Modern arrow function for ready handler
  const ready = (fn) => {
    if (document.readyState !== 'loading'){
      fn();
    } else {
      document.addEventListener('DOMContentLoaded', fn);
    }
  };

  ready(() => {
    enableKeyboardShortcuts();
  });

  // Main keyboard shortcut enabler with arrow functions
  const enableKeyboardShortcuts = () => {
    // Ctrl+Shift+A to generate an assertion
    const keydown = (event) => {
      if (event.ctrlKey && event.shiftKey && event.key === 'A') {
        event.preventDefault();
        generateAssertion();
      }
    };

    document.addEventListener('keydown', keydown, false);

    const generateAssertion = () => {
      const text = selectedText().trim();
      if (text.length > 0) {
        const action = assertMethod() + text.replace("'", "\\'") + "'";
        const testingOutput = JSON.parse(sessionStorage.getItem("testingOutput"));
        const target = "";
        const options = "";
        const accept = "You selected:\n\r" + text + "\n\rOk: Type `flush` into debugger console to add to test.\nCancel: To select new text.";
        if (window.confirm(accept)) {
          testingOutput.push({action, target, options});
          sessionStorage.setItem("testingOutput", JSON.stringify(testingOutput));
        } else {
          console.log("Assertion was not generated.");
        }
      }
    };

    // Right-click to generate an assertion
    const riteklick = (event) => {
      if (event.button === 2) {
        window.addEventListener("contextmenu", (e) => e.preventDefault());
        setupAssertion(event);
      }
    };

    document.addEventListener('mousedown', riteklick);

    const setupAssertion = (event) => {
      const text = selectedText().trim();
      if (text.length > 0) {
        const action = assertMethod() + text.replace("'", "\\'") + "'";
        const testingOutput = JSON.parse(sessionStorage.getItem("testingOutput"));
        const target = "";
        const options = "";
        const accept = "You selected:\n\r" + text + "\n\rOk: Type `flush` into debugger console to add to test.\nCancel: To select new text.";
        if (window.confirm(accept)) {
          testingOutput.push({action, target, options});
          sessionStorage.setItem("testingOutput", JSON.stringify(testingOutput));
        } else {
          console.log("Assertion was not generated.");
        }
      }
    };

    const assertMethod = () => {
      <%- if defined? RSpec %>
        return "expect(page).to have_content '";
      <%- else %>
        return "assert page.has_content? '";
      <%- end %>
    };

    const selectedText = () => {
      let text = "";
      if (window.getSelection) {
        text = window.getSelection().toString();
      } else if (document.selection && document.selection.type !== "Control") {
        text = document.selection.createRange().text;
      }
      return text;
    };
  };
</script>
