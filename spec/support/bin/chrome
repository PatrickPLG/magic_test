#!/bin/sh
# Chrome launcher for the gem's own test suite.
# Resolves the binary (CHROME_BIN, then known locations) and always adds
# --no-sandbox: Chrome refuses to sandbox as root (containers), and Ubuntu
# 24.04 runners (GitHub Actions) block unprivileged user namespaces, so the
# sandbox fails to start there as a normal user too. --disable-dev-shm-usage
# keeps Chrome off the small /dev/shm of CI containers.
BIN="${CHROME_BIN:-}"
if [ -z "$BIN" ]; then
  for candidate in /opt/pw-browsers/chromium-1194/chrome-linux/chrome \
                   /opt/pw-browsers/chromium/chrome-linux/chrome \
                   "$(command -v google-chrome 2>/dev/null)" \
                   "$(command -v google-chrome-stable 2>/dev/null)" \
                   "$(command -v chromium 2>/dev/null)" \
                   "$(command -v chromium-browser 2>/dev/null)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then BIN="$candidate"; break; fi
  done
fi
if [ -z "$BIN" ]; then
  echo "spec/support/bin/chrome: no Chrome binary found (set CHROME_BIN)" >&2
  exit 127
fi
exec "$BIN" --no-sandbox --disable-dev-shm-usage "$@"
