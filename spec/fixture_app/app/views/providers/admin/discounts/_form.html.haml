= simple_form_for(@discount, url: (@discount.persisted? ? provider_admin_discount_path(@provider, @discount) : provider_admin_discounts_path(@provider)), html: {multipart: true}) do |f|
  = f.error_notification
  = f.input :name_da, required: true
  = f.input :name_en
  = f.input :description, as: :text, input_html: {rows: 3}
  = f.input :status, collection: discount_status_options, include_blank: false, input_html: {class: "chosen-select"}
  = f.input :category_ids, collection: Category.order(:name), label: t("activerecord.attributes.discount.categories"), input_html: {multiple: true, class: "chosen-select", data: {placeholder: "Vælg kategorier"}}
  = render "shared/cover_image_upload", f: f, object: @discount, field: :cover_image
  = f.button :submit, t("helpers.submit.discount.#{@discount.persisted? ? "update" : "create"}"), class: "btn btn-primary"
