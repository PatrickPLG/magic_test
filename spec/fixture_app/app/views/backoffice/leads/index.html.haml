%h1= t("leads.index.title")
%table.table#leads-table
  %thead
    %tr
      %th Navn
      %th E-mail
      %th Status
      %th
  %tbody
    - @leads.each do |lead|
      %tr{id: "lead_#{lead.id}"}
        %td= lead.name
        %td= lead.email
        %td= lead.status
        %td= link_to t("leads.index.edit"), edit_backoffice_lead_path(lead), class: "btn btn-sm btn-outline-primary"
= paginate @leads
