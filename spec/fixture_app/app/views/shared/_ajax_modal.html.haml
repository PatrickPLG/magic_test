#ajax-modal.modal.fade{tabindex: "-1", role: "dialog"}
  .modal-dialog
    .modal-content.modal-white
      .modal-header
        %button.btn-close{"aria-label" => "Close", "data-bs-dismiss" => "modal", type: "button"}
      .modal-body
        .d-flex.justify-content-center
          .d-flex.spinner-border{role: "status"}
          .visually-hidden
            #load= "Loading..."
