%h1= t("profile.edit.title")
= simple_form_for(@student, url: profile_path, html: {id: "profile-form"}) do |f|
  = f.input :first_name
  = f.input :last_name
  .mb-3
    = f.label :birthday, class: "form-label"
    = f.text_field :birthday, value: @student.birthday&.strftime("%d/%m-%Y"), class: "form-control js-datepicker-birthday-field", placeholder: "dd/mm-åååå"
  .mb-3
    %label.form-label= t("activerecord.attributes.student.gender")
    - %w[male female other].each do |g|
      %label.checkmark-container.d-block
        = f.radio_button :gender, g, class: "visually-hidden"
        %span.checkmark
        = t("profile.edit.#{g}")
  .mb-3
    %label.checkmark-container.d-block
      = f.check_box :newsletter, class: "visually-hidden"
      %span.checkmark
      = t("activerecord.attributes.student.newsletter")
  = f.input :country, collection: [["Danmark", "DK"], ["Sverige", "SE"], ["Norge", "NO"], ["Tyskland", "DE"], ["Grønland", "GL"]], include_blank: false
  = f.input :bio, as: :text, input_html: {rows: 4}
  = f.button :submit, t("helpers.submit.student.update"), class: "btn btn-primary"
